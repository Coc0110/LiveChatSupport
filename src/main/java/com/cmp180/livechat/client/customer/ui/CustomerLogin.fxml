<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="530.0" prefWidth="420.0" style="-fx-background-color: #f4f7fb;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cmp180.livechat.client.customer.ui.CustomerLoginController">
   <children>
      <VBox alignment="CENTER" layoutX="35.0" layoutY="35.0" prefHeight="460.0" prefWidth="350.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 10); -fx-padding: 25;">
         <children>
            <Label text="Hỗ trợ trực tuyến" textFill="#0084ff">
               <font>
                  <Font name="Segoe UI Bold" size="26.0" />
               </font>
            </Label>
            
            <Label text="Vui lòng nhập tên của bạn để bắt đầu" textFill="#888888">
               <font>
                  <Font name="Segoe UI" size="13.0" />
               </font>
            </Label>
            
            <VBox spacing="10.0">
               <children>
                  <TextField fx:id="txtName" prefHeight="42.0" promptText="Tên của bạn" style="-fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-color: white; -fx-padding: 0 15; -fx-font-size: 14;" />
                  
                  <ComboBox fx:id="cbIssue" prefHeight="42.0" prefWidth="350.0" promptText="Chọn vấn đề cần tư vấn..." style="-fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-color: white; -fx-font-size: 14;" />

                  <!-- Cấu hình Server (Playit.gg / LAN IP) -->
                  <HBox spacing="8.0" alignment="CENTER">
                     <children>
                        <TextField fx:id="txtHost" prefHeight="38.0" promptText="Server (Mặc định: 127.0.0.1)" style="-fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-color: white; -fx-padding: 0 10; -fx-font-size: 12;" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtPort" prefHeight="38.0" prefWidth="95.0" promptText="Port (5000)" style="-fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-color: white; -fx-padding: 0 10; -fx-font-size: 12;" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <Label fx:id="lblError" text="" textFill="RED">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
            
            <Button fx:id="btnConnect" mnemonicParsing="false" onAction="#handleConnect" prefHeight="45.0" prefWidth="350.0" style="-fx-background-color: #0084FF; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Bắt đầu Chat">
               <font>
                  <Font name="Segoe UI Bold" size="14.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>

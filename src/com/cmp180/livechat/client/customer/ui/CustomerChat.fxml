<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="500.0" style="-fx-background-color: #e5e5ea;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cmp180.livechat.client.customer.ui.CustomerChatController">
   
   <!-- Header Chat -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="500.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 0 20;" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="2">
               <Label fx:id="lblTitle" text="Trung tâm Hỗ trợ">
                  <font>
                     <Font name="Segoe UI Bold" size="18.0" />
                  </font>
               </Label>
               <Label fx:id="lblStatus" text="Đang chờ nhân viên kết nối..." textFill="#888888">
                  <font>
                     <Font name="Segoe UI" size="13.0" />
                  </font>
               </Label>
            </VBox>
         </children>
      </HBox>
   </top>
   
   <!-- Khung hiển thị tin nhắn -->
   <center>
      <ListView fx:id="listMessages" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #e5e5ea; -fx-border-width: 0;" BorderPane.alignment="CENTER" />
   </center>
   
   <!-- Khu vực soạn tin nhắn -->
   <bottom>
      <VBox style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
         <children>
            <!-- Thanh công cụ (đính kèm) -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 10 20 0 20;">
               <!-- Attach Image Button -->

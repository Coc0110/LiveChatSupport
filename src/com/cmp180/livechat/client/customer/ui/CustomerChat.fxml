                  </graphic>
               </Button>
               <!-- Attach File Button -->
               <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                  <graphic>
                     <SVGPath content="M4.53564 11.4647L11.4299 4.5704C13.4802 2.52015 16.8044 2.52015 18.8546 4.5704C20.9049 6.62066 20.9046 9.94496 18.8544 11.9952L10.8994 19.9502C9.53258 21.317 7.31688 21.3168 5.95004 19.95C4.58321 18.5831 4.58287 16.3673 5.94971 15.0005L13.9047 7.0455C14.5881 6.36208 15.6967 6.36208 16.3801 7.0455C17.0635 7.72892 17.0631 8.83669 16.3796 9.52011L9.48535 16.4144" fill="transparent" stroke="#72808e" strokeLineCap="ROUND" strokeLineJoin="ROUND" strokeWidth="2" />
                  </graphic>
               </Button>
            </HBox>
            
            <!-- Vùng Text và Nút Gửi -->
            <HBox alignment="CENTER" prefHeight="70.0" prefWidth="500.0" style="-fx-padding: 10 20 20 20; -fx-spacing: 15;">
               <children>
                  <TextField fx:id="txtMessage" disable="true" prefHeight="45.0" promptText="Nhập tin nhắn..." style="-fx-background-color: #f0f2f5; -fx-background-radius: 20; -fx-padding: 0 20; -fx-font-size: 15;" HBox.hgrow="ALWAYS" />
                  <!-- Send Button -->
                  <Button fx:id="btnSend" disable="true" mnemonicParsing="false" onAction="#handleSend" prefHeight="45.0" prefWidth="45.0" style="-fx-background-color: #0084FF; -fx-background-radius: 50; -fx-cursor: hand;">
                     <graphic>
                        <SVGPath content="M10.3078 13.6923L15.1539 8.84619M20.1113 5.88867L16.0207 19.1833C15.6541 20.3747 15.4706 20.9707 15.1544 21.1683C14.8802 21.3396 14.5406 21.3683 14.2419 21.2443C13.8975 21.1014 13.618 20.5433 13.0603 19.428L10.4694 14.2461C10.3809 14.0691 10.3366 13.981 10.2775 13.9043C10.225 13.8363 10.1645 13.7749 10.0965 13.7225C10.0215 13.6647 9.93486 13.6214 9.76577 13.5369L4.57192 10.9399C3.45662 10.3823 2.89892 10.1032 2.75601 9.75879C2.63207 9.4601 2.66033 9.12023 2.83169 8.84597C3.02928 8.52974 3.62523 8.34603 4.81704 7.97932L18.1116 3.88867C19.0486 3.60038 19.5173 3.45635 19.8337 3.57253C20.1094 3.67373 20.3267 3.89084 20.4279 4.16651C20.544 4.48283 20.3999 4.95126 20.1119 5.88729L20.1113 5.88867Z" fill="transparent" stroke="white" strokeLineCap="ROUND" strokeLineJoin="ROUND" strokeWidth="2" />
                     </graphic>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
